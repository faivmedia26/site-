# Optional GitHub Pages workflow template.
# Copy to the repository root at .github/workflows/deploy-uwem-pages.yml
# only after confirming that this Pages site should publish this project.
name: Deploy Uwem Ministries International site

on:
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Set up Node for the calendar tests
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Test countdown date logic
        working-directory: uwem-ministries
        run: npm test

      - name: Upload static site artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: uwem-ministries

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
